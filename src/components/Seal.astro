---
// Sceau du sticker Qnife : texte circulaire autour du Q.
interface Props { class?: string }
const { class: cls } = Astro.props;
const text = 'Votre histoire, votre couteau — Coutelier des Hauts-de-France — ';
---
<svg class={`seal ${cls ?? ''}`} viewBox="0 0 200 200" role="img" aria-label="Qnife, votre histoire, votre couteau, coutelier des Hauts-de-France">
  <defs><path id="seal-ring" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" /></defs>
  <g class="seal-ring" aria-hidden="true">
    <text><textPath href="#seal-ring" startOffset="0" textLength="500" lengthAdjust="spacing">{text}</textPath></text>
  </g>
  <text class="seal-q" x="100" y="128" text-anchor="middle" aria-hidden="true">Q</text>
</svg>
