---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('pages', 'mentions-legales');
if (!entry) throw new Error('Texte manquant : src/content/pages/mentions-legales.md');
const { Content } = await render(entry);
---
<Base solid noindex title={entry.data.title} description={entry.data.description}>
  <div class="wrap page-head"><h1>{entry.data.title}</h1></div>
  <div class="wrap prose">
    <Content />
  </div>
</Base>
<style>mark { background: var(--paper); color: var(--ink); padding: 0 0.3em; }</style>
