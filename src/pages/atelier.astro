---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';

const entry = (await getEntry('pages', 'atelier'))!;
const t = entry.data;
const { Content } = await render(entry);
---
<Base solid title={t.title} description={t.description}>
  <div class="wrap page-head">
    <h1>{t.titre}</h1>
    <p class="muted">{t.intro}</p>
  </div>
  <div class="wrap shots">
    <Pic slug="portrait" sizes="(min-width: 52rem) 30vw, 90vw" />
    <Pic slug="martelage" sizes="(min-width: 52rem) 30vw, 90vw" />
    <Pic slug="etabli" sizes="(min-width: 52rem) 30vw, 90vw" class="third" />
  </div>
  <div class="wrap prose">
    <Content />
    <p><a class="btn" href="/sur-mesure/">{t.cta}</a></p>
  </div>
</Base>
<style>
  .shots { display: grid; gap: 0.75rem; grid-template-columns: 1fr 1fr; padding-bottom: 2rem; }
  .shots :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 1.25rem; }
  .shots :global(.third) { grid-column: 1 / -1; aspect-ratio: 16 / 10; object-position: 50% 40%; }
  @media (min-width: 52rem) { .shots { grid-template-columns: repeat(3, 1fr); } .shots :global(.third) { grid-column: auto; aspect-ratio: 3 / 4; } }
</style>
