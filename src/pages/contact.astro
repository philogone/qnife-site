---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const t = (await getEntry('pages', 'contact'))!.data;
const mail = `mailto:${site.email}`;
---
<Base solid title={t.title} description={t.description}>
  <div class="wrap page-head">
    <h1>{t.titre}</h1>
    <p class="muted">{t.intro}</p>
  </div>
  <div class="wrap prose">
    <h2>{t.titre_mail}</h2>
    <p><a class="big" href={mail}>{site.email}</a></p>
    <h2>{t.titre_instagram}</h2>
    <p><a class="big" href={site.instagram} rel="noopener noreferrer">{site.instagramHandle}</a></p>
    <h2>{t.titre_atelier}</h2>
    <address>{site.address.zip} {site.address.city}</address>
  </div>
</Base>
<style>
  .big { font-size: clamp(1.5rem, 6vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; word-break: break-word; }
  address { font-style: normal; font-size: 1.2rem; }
</style>
