---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import photos from '../data/photos.json';
import { site } from '../data/site';

const pick = ['jules', 'gaston', 'igor', 'cyrus'];
const works = pick.map((s) => photos.knives.find((k) => k.slug === s)!);
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Un couteau sur mesure')}`;
const marquee = ['Forgé à la main', 'Façonné à Haubourdin', "Signé d'un prénom", 'Sur mesure'];
---
<Base
  title="Coutelier artisan à Haubourdin"
  description="Qnife, atelier de coutellerie à Haubourdin (Hauts-de-France) : couteaux de table, de cuisine, pliants et forgés, faits main et sur mesure. Votre histoire, votre couteau."
>
  <section class="hero" aria-labelledby="h1">
    <div class="hero-grid wrap">
      <div>
        <span class="sticker">Coutelier · Haubourdin, 59</span>
        <h1 id="h1">Votre histoire,<br />votre couteau.</h1>
        <p class="lede">Chaque lame est forgée, façonnée et signée à la main. Racontez-moi qui va l'utiliser, je la dessine pour lui.</p>
        <div class="actions">
          <a class="cta" href="/sur-mesure/">Demander un couteau sur mesure →</a>
          <a class="cta cta--ghost" href="/couteaux/">Voir les couteaux</a>
        </div>
      </div>
      <div class="hero-photo">
        <Pic slug="hero-chef" loading="eager" fetchpriority="high" sizes="(min-width: 60rem) 30rem, 88vw" alt="Le coutelier tient un couteau de chef dans son atelier, lumière chaude de la forge" />
        <div class="seal" aria-hidden="true">
          <svg class="seal-ring" viewBox="0 0 120 120" width="100%" height="100%">
            <defs><path id="ring" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
            <circle cx="60" cy="60" r="58" fill="#f7f6f1" />
            <text font-family="Mostra Nuova, sans-serif" font-weight="700" font-size="11.5" letter-spacing="2.2" fill="#141414"><textPath href="#ring">COUTELIER DES HAUTS-DE-FRANCE • </textPath></text>
          </svg>
          <span class="seal-q">Q</span>
        </div>
      </div>
    </div>
  </section>

  <section class="marquee-band" aria-label="Slogans">
    <div class="marquee" aria-hidden="true">
      {[0, 1].map(() => (
        <span>{marquee.map((m) => <>{m} ✦ </>)}</span>
      ))}
    </div>
  </section>

  <section id="couteaux" class="works wrap" aria-labelledby="h-works">
    <div class="section-head">
      <h2 id="h-works">Les derniers<br />couteaux.</h2>
      <a class="arrow-link" href="/couteaux/">Tous les couteaux →</a>
    </div>
    <ul class="bento">
      {works.map((k) => (
        <li class="card">
          <Pic slug={k.slug} sizes="(min-width: 60rem) 22rem, 45vw" />
          <span class="card-tag">{k.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="atelier" class="workshop" aria-labelledby="h-workshop">
    <div class="wrap workshop-grid">
      <div>
        <p class="label">L'atelier</p>
        <h2 id="h-workshop">Une forge, un établi, une seule main.</h2>
      </div>
      <div>
        <p>Acier à ressort, T7Mo ou XC75 pour la lame. Ébène, hêtre échauffé, bois de rose ou olivier pour le manche. Laiton pour les rivets.</p>
        <p>Pas de perfection industrielle : chaque couteau garde la trace de son bois.</p>
        <ul class="chips">
          <li>Forge à gaz</li>
          <li>Ponceuse à bande</li>
          <li>Établi</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="sur-mesure" class="bespoke wrap" aria-labelledby="h-bespoke">
    <div class="two-col">
      <div>
        <h2 id="h-bespoke">Un couteau<br />à votre histoire.</h2>
        <p class="lede-dark">Un cadeau, une table à équiper, une cuisine qui mérite mieux. Racontez-moi, je dessine et je fabrique le couteau qui va avec.</p>
        <a class="cta" href="/sur-mesure/">Comment commander →</a>
      </div>
      <div>
        <ul class="tiles">
          {site.prices.map((p, i) => (
            <li class={`tile${i % 2 ? ' tile--dark' : ''}`}>
              <p>{p.label}</p>
              <p class="price"><small>dès </small>{p.from} €</p>
            </li>
          ))}
        </ul>
        <p class="fineprint">Prix indicatifs, selon les matériaux et les finitions. Délai : sur demande, communiqué avec le devis.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="reach wrap" aria-labelledby="h-reach">
    <div class="reach-box">
      <h2 id="h-reach">Écrivez-moi,<br />on en parle autour d'une lame.</h2>
      <div class="actions">
        <a class="cta" href={mail}>{site.email}</a>
        <a class="cta cta--ghost" href={site.instagram} rel="noopener">Instagram {site.instagramHandle}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 6rem; padding-bottom: 3rem; }
  .hero-grid { display: grid; gap: 2.5rem; }
  .hero h1 { font-size: clamp(3.4rem, 13vw, 8.5rem); font-weight: 700; line-height: 0.92; letter-spacing: -0.035em; margin-top: 1.25rem; }
  .lede { margin-top: 1.5rem; font-size: 1.2rem; max-width: 32ch; }
  .actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .sticker { display: inline-block; transform: rotate(-4deg); background: var(--paper); color: var(--ink); font-weight: 700; font-size: 0.9rem; padding: 0.35rem 0.9rem; border-radius: 0.4rem; box-shadow: 4px 4px 0 var(--graphite); }
  .cta { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.5rem; padding: 0.9rem 1.7rem; background: var(--mist); color: var(--ink); font-weight: 700; text-decoration: none; border-radius: 999px; transition: background-color 0.25s var(--ease), color 0.25s var(--ease); }
  .cta:hover { background: var(--paper); }
  .cta--ghost { background: transparent; color: var(--paper); border: 1.5px solid var(--paper); }
  .cta--ghost:hover { background: var(--paper); color: var(--ink); }
  .hero-photo { position: relative; justify-self: center; width: min(88vw, 30rem); }
  .hero-photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 1.75rem; }
  .seal { position: absolute; right: -1.25rem; bottom: -1.25rem; width: 8.5rem; height: 8.5rem; }
  .seal-ring { animation: spin 22s linear infinite; transform-origin: 50% 50%; }
  .seal-q { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 3.5rem; color: var(--ink); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .marquee-band { background: var(--paper); color: var(--ink); overflow: hidden; padding-block: 1.1rem; }
  .marquee { display: flex; width: max-content; animation: slide 28s linear infinite; }
  .marquee span { font-weight: 700; font-size: clamp(1.8rem, 5vw, 3.2rem); letter-spacing: -0.02em; white-space: nowrap; padding-right: 1.5rem; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee, .seal-ring { animation: none; } }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 2rem; padding-top: clamp(4rem, 12vw, 7rem); }
  h2 { font-size: clamp(2.4rem, 7vw, 4.5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .card { position: relative; overflow: hidden; border-radius: 1.25rem; background: var(--anthracite); }
  .card :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 0.6s var(--ease); }
  .card:hover :global(img) { transform: scale(1.03); }
  .card:nth-child(even) { transform: rotate(-1.5deg); }
  .card:nth-child(odd) { transform: rotate(1deg); }
  .card:hover { transform: rotate(0) translateY(-4px); transition: transform 0.4s var(--ease); }
  .card-tag { position: absolute; left: 1rem; bottom: 1rem; font-weight: 700; font-size: 1.1rem; background: var(--paper); color: var(--ink); padding: 0.2rem 0.8rem; border-radius: 999px; }
  .workshop { background: var(--anthracite); padding-block: clamp(4rem, 11vw, 7rem); margin-top: clamp(4rem, 12vw, 8rem); }
  .workshop-grid { display: grid; gap: 3rem; }
  .workshop .label { font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.85rem; color: var(--mist); }
  .chips { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { background: var(--ink); color: var(--paper); padding: 0.4rem 0.9rem; border-radius: 999px; font-size: 0.9rem; }
  .bespoke { background: var(--paper); color: var(--ink); padding-block: clamp(4rem, 12vw, 7rem); margin-top: clamp(4rem, 12vw, 8rem); }
  .bespoke .cta { background: var(--ink); color: var(--paper); }
  .bespoke .cta:hover { background: var(--graphite); }
  .lede-dark { margin-top: 1.5rem; font-size: 1.15rem; max-width: 40ch; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .tile { border-radius: 1.25rem; padding: 1.75rem; background: var(--ink); color: var(--paper); }
  .tile--dark { background: var(--paper); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .tile p { margin: 0; font-size: 1rem; }
  .price { margin-top: 1rem !important; font-size: 2.4rem; font-weight: 700; letter-spacing: -0.02em; }
  .price small { font-size: 0.85rem; font-weight: 400; }
  .fineprint { margin-top: 1.25rem; font-size: 0.9rem; opacity: 0.8; }
  .reach { padding-block: clamp(3rem, 9vw, 6rem); }
  .reach-box { border: 1.5px solid var(--paper); border-radius: 1.75rem; padding: clamp(1.75rem, 5vw, 3.5rem); }
  .reach h2 { margin-bottom: 0; font-size: clamp(2.2rem, 6vw, 3.75rem); }
  .two-col { display: grid; gap: 2.5rem; }
  @media (min-width: 52rem) {
    .hero-grid { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 5rem; }
    .workshop-grid, .two-col { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 5rem; }
    .bento { grid-template-columns: repeat(4, 1fr); }
  }
</style>
