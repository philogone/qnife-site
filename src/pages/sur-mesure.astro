---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const t = (await getEntry('pages', 'sur-mesure'))!.data;
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Un couteau sur mesure')}`;
---
<Base solid title={t.title} description={t.description}>
  <div class="wrap page-head">
    <h1>{t.titre}</h1>
    <p class="muted">{t.intro}</p>
  </div>
  <div class="wrap prose">
    <h2>{t.titre_etapes}</h2>
    <ol class="steps">
      {t.etapes.map((e) => <li><h3>{e.titre}</h3><p>{e.texte}</p></li>)}
    </ol>
    <h2>{t.titre_prix}</h2>
    <ul class="prices">
      {site.prices.map((p) => <li><span class="what">{p.label}</span><span class="from"><small>dès</small>{p.from} €</span></li>)}
    </ul>
    <p class="fineprint muted">{t.fineprint}</p>
    <p style="margin-top:2.5rem"><a class="btn" href={mail}>{t.cta_mail} {site.email}</a></p>
    <p class="muted">{t.insta_avant} <a href={site.instagram} rel="noopener noreferrer">{site.instagramHandle}</a>.</p>
  </div>
</Base>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.75rem; max-width: var(--measure); }
  .steps h3 { margin: 0 0 0.35rem; }
  .steps p { margin: 0; color: var(--mist); }
  .prices { border-top-color: var(--graphite); padding: 0; list-style: none; max-width: 40rem; }
  .prices li { border-bottom-color: var(--graphite); }
</style>
