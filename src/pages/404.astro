---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';

const t = (await getEntry('pages', '404'))!.data;
---
<Base solid noindex title={t.title} description={t.description}>
  <div class="wrap page-head">
    <h1><Lines text={t.titre} /></h1>
    <p class="muted">{t.intro}</p>
    <p style="margin-top:2rem"><a class="btn" href="/">{t.cta}</a></p>
  </div>
</Base>
